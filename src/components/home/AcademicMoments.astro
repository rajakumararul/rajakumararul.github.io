---
import SectionHeading from '../SectionHeading.astro';
import GalleryCard from '../GalleryCard.astro';
import Icon from '../Icon.astro';
import { getAlbums } from '../../lib/gallery';
import { site } from '../../config/site';
import { url } from '../../lib/url';

const albums = await getAlbums((a) => a.data.featured);
---

{
  albums.length > 0 && (
    <section class="relative overflow-hidden py-20 sm:py-28" aria-labelledby="moments-title">
      <div class="container-page">
        <SectionHeading
          id="moments-title"
          eyebrow="Academic Moments"
          title="Moments from the journey"
          intro="Talks, programmes, recognitions and collaborations, captured in photographs."
          href="/gallery"
          linkLabel="Open the gallery"
        />
      </div>

      <div
        data-carousel
        data-autoplay={site.gallery.autoplay ? String(site.gallery.intervalMs) : undefined}
        role="region"
        aria-roledescription="carousel"
        aria-label="Academic Moments"
        class="reveal"
      >
        <div class="container-page">
          <div class="mb-5 flex items-center justify-between gap-4">
            <p class="text-xs text-muted" data-carousel-status aria-live="polite">
              {albums.length} albums
            </p>
            <div class="flex items-center gap-2">
              <button
                type="button"
                data-carousel-toggle
                class="hidden h-10 w-10 place-items-center rounded-full border border-line text-ink-soft transition-colors hover:border-accent hover:text-accent"
                aria-label="Pause automatic slide show"
              >
                <span data-icon-pause><Icon name="pause" size={16} /></span>
                <span data-icon-play class="hidden"><Icon name="play" size={16} /></span>
              </button>
              <button
                type="button"
                data-carousel-prev
                class="grid h-10 w-10 place-items-center rounded-full border border-line text-ink transition-colors hover:border-accent hover:text-accent disabled:pointer-events-none disabled:opacity-35"
                aria-label="Previous album"
              >
                <Icon name="chevron-left" size={18} />
              </button>
              <button
                type="button"
                data-carousel-next
                class="grid h-10 w-10 place-items-center rounded-full border border-line text-ink transition-colors hover:border-accent hover:text-accent disabled:pointer-events-none disabled:opacity-35"
                aria-label="Next album"
              >
                <Icon name="chevron-right" size={18} />
              </button>
            </div>
          </div>
        </div>

        <ul
          data-carousel-track
          tabindex="0"
          aria-label="Albums — use the left and right arrow keys to browse"
          class="carousel-track flex snap-x snap-mandatory gap-5 overflow-x-auto pb-6 focus-visible:outline-none"
        >
          {albums.map((album, i) => (
            <li
              class="carousel-slide w-[84%] shrink-0 snap-start sm:w-[58%] lg:w-[calc((min(100vw,76rem)-4rem-2.5rem)/3)]"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${albums.length}: ${album.data.title}`}
            >
              <GalleryCard album={album} />
            </li>
          ))}
        </ul>
      </div>

      <div class="container-page mt-4 sm:hidden">
        <a href={url('/gallery')} class="btn btn-ghost w-full justify-center">
          Browse all albums <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </section>
  )
}

<style>
  /* Track aligned with the page container, bleeding to the right edge. */
  .carousel-track {
    padding-inline: max(1.25rem, calc((100vw - 76rem) / 2 + 2rem));
    scroll-padding-inline: max(1.25rem, calc((100vw - 76rem) / 2 + 2rem));
    scrollbar-width: none;
    scroll-behavior: smooth;
  }
  @media (max-width: 639px) {
    .carousel-track {
      padding-inline: 1.25rem;
      scroll-padding-inline: 1.25rem;
    }
  }
  .carousel-track::-webkit-scrollbar {
    display: none;
  }
  .carousel-track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-carousel-toggle]')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const interval = Number(root.dataset.autoplay || 0);

    const step = () => {
      const first = slides[0];
      const gap = parseFloat(getComputedStyle(track).columnGap || '0');
      return first ? first.getBoundingClientRect().width + gap : track.clientWidth;
    };
    const atStart = () => track.scrollLeft <= 4;
    const atEnd = () => track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    const update = () => {
      prev.disabled = atStart();
      next.disabled = atEnd();
    };
    const go = (dir: 1 | -1) => track.scrollBy({ left: dir * step(), behavior: reduceMotion ? 'auto' : 'smooth' });

    // ── Auto-advance ──
    let timer = 0;
    let stopped = !interval || reduceMotion; // user stopped it, or not allowed
    let hovering = false;
    let visible = false;

    const tick = () => {
      if (atEnd()) track.scrollTo({ left: 0, behavior: 'smooth' });
      else go(1);
    };
    const schedule = () => {
      window.clearInterval(timer);
      if (!stopped && !hovering && visible && !document.hidden) timer = window.setInterval(tick, interval);
    };
    const setStopped = (value: boolean) => {
      stopped = value;
      toggle.setAttribute('aria-label', stopped ? 'Start automatic slide show' : 'Pause automatic slide show');
      toggle.querySelector('[data-icon-pause]')?.classList.toggle('hidden', stopped);
      toggle.querySelector('[data-icon-play]')?.classList.toggle('hidden', !stopped);
      schedule();
    };

    if (interval && !reduceMotion) {
      toggle.classList.remove('hidden');
      toggle.classList.add('grid');
      toggle.addEventListener('click', () => setStopped(!stopped));
      setStopped(false);
    }

    // Any direct interaction hands control to the visitor.
    const takeControl = () => interval && !reduceMotion && !stopped && setStopped(true);
    prev.addEventListener('click', () => (takeControl(), go(-1)));
    next.addEventListener('click', () => (takeControl(), go(1)));
    track.addEventListener('pointerdown', takeControl);
    track.addEventListener('wheel', (e) => Math.abs(e.deltaX) > Math.abs(e.deltaY) && takeControl(), { passive: true });
    track.addEventListener('keydown', (e) => {
      const keys: Record<string, () => void> = {
        ArrowRight: () => go(1),
        ArrowLeft: () => go(-1),
        Home: () => track.scrollTo({ left: 0 }),
        End: () => track.scrollTo({ left: track.scrollWidth }),
      };
      if (keys[e.key]) {
        e.preventDefault();
        takeControl();
        keys[e.key]();
      }
    });

    // Pause while hovered or focused.
    root.addEventListener('mouseenter', () => ((hovering = true), schedule()));
    root.addEventListener('mouseleave', () => ((hovering = false), schedule()));
    root.addEventListener('focusin', () => ((hovering = true), schedule()));
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) (hovering = false), schedule();
    });
    new IntersectionObserver(([entry]) => ((visible = entry.isIntersecting), schedule()), { threshold: 0.3 }).observe(root);
    document.addEventListener('visibilitychange', schedule);

    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>
