---
/**
 * Subtle animated background for the hero: a jittered lattice of points
 * (a nod to lattice-based cryptography) with faint links and occasional
 * "photon" pulses travelling between nodes (a nod to QKD).
 * Static frame when the visitor prefers reduced motion; pauses off-screen.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<canvas data-quantum-field class:list={['pointer-events-none absolute inset-0 h-full w-full', className]} aria-hidden="true"
></canvas>

<script>
  type Node = { x: number; y: number; ox: number; oy: number; phase: number; speed: number };
  type Pulse = { a: number; b: number; t: number; speed: number };

  const canvas = document.querySelector<HTMLCanvasElement>('[data-quantum-field]');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let nodes: Node[] = [];
    let links: [number, number][] = [];
    let pulses: Pulse[] = [];
    let w = 0;
    let h = 0;
    let raf = 0;
    let visible = true;
    let colors = { line: '', dot: '', pulse: '' };

    const readColors = () => {
      const s = getComputedStyle(document.documentElement);
      const glow = s.getPropertyValue('--glow').trim();
      const dark = document.documentElement.dataset.theme === 'dark';
      colors = {
        line: `rgb(${glow} / ${dark ? 0.16 : 0.12})`,
        dot: `rgb(${glow} / ${dark ? 0.55 : 0.4})`,
        pulse: s.getPropertyValue('--accent-2').trim(),
      };
    };

    const build = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const gap = w < 640 ? 64 : 84;
      const cols = Math.ceil(w / gap) + 1;
      const rows = Math.ceil(h / gap) + 1;
      nodes = [];
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          // Skewed lattice basis rather than a square grid.
          const ox = c * gap + (r % 2) * (gap / 2) + (Math.random() - 0.5) * gap * 0.35;
          const oy = r * gap * 0.86 + (Math.random() - 0.5) * gap * 0.35;
          nodes.push({ x: ox, y: oy, ox, oy, phase: Math.random() * Math.PI * 2, speed: 0.2 + Math.random() * 0.35 });
        }
      }
      links = [];
      const max = gap * 1.25;
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].ox - nodes[j].ox;
          const dy = nodes[i].oy - nodes[j].oy;
          if (dx * dx + dy * dy < max * max && Math.random() > 0.35) links.push([i, j]);
        }
      }
      pulses = [];
    };

    const draw = (time: number) => {
      ctx.clearRect(0, 0, w, h);
      const t = time / 1000;

      for (const n of nodes) {
        n.x = n.ox + Math.sin(t * n.speed + n.phase) * 3;
        n.y = n.oy + Math.cos(t * n.speed * 0.8 + n.phase) * 3;
      }

      ctx.lineWidth = 1;
      ctx.strokeStyle = colors.line;
      ctx.beginPath();
      for (const [a, b] of links) {
        ctx.moveTo(nodes[a].x, nodes[a].y);
        ctx.lineTo(nodes[b].x, nodes[b].y);
      }
      ctx.stroke();

      ctx.fillStyle = colors.dot;
      for (const n of nodes) {
        ctx.beginPath();
        ctx.arc(n.x, n.y, 1.4, 0, Math.PI * 2);
        ctx.fill();
      }

      if (!reduce) {
        if (pulses.length < 6 && Math.random() < 0.03 && links.length) {
          const [a, b] = links[Math.floor(Math.random() * links.length)];
          pulses.push({ a, b, t: 0, speed: 0.006 + Math.random() * 0.008 });
        }
        for (const p of pulses) {
          p.t += p.speed;
          const A = nodes[p.a];
          const B = nodes[p.b];
          const x = A.x + (B.x - A.x) * p.t;
          const y = A.y + (B.y - A.y) * p.t;
          const alpha = Math.sin(Math.PI * Math.min(p.t, 1));
          const g = ctx.createRadialGradient(x, y, 0, x, y, 10);
          g.addColorStop(0, colors.pulse);
          g.addColorStop(1, 'transparent');
          ctx.globalAlpha = alpha * 0.9;
          ctx.fillStyle = g;
          ctx.beginPath();
          ctx.arc(x, y, 10, 0, Math.PI * 2);
          ctx.fill();
          ctx.globalAlpha = 1;
        }
        pulses = pulses.filter((p) => p.t < 1);
      }
    };

    const loop = (time: number) => {
      draw(time);
      if (visible && !reduce) raf = requestAnimationFrame(loop);
    };
    const start = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(loop);
    };

    readColors();
    build();
    start();

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        build();
        start();
      }, 150);
    });
    new MutationObserver(() => {
      readColors();
      if (reduce) start();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) start();
    }).observe(canvas);
    document.addEventListener('visibilitychange', () => {
      visible = !document.hidden;
      if (visible) start();
    });
  }
</script>
