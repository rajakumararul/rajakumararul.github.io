---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import VerifyBadge from './VerifyBadge.astro';
import { formatDate } from '../lib/format';
import { url } from '../lib/url';

interface Props {
  item: CollectionEntry<'achievements'>;
}
const a = Astro.props.item.data;
const media = a.photo ?? a.certificateImage;
const when = a.date ? formatDate(a.date, 'long') : a.years.length ? a.years.join(', ') : null;
const icon = a.kind === 'certification' ? 'certificate' : 'award';
---

<li class="card flex gap-4 p-5 sm:p-6">
  {
    media ? (
      <Image src={media} alt={`${a.title} — ${a.photo ? 'photograph' : 'certificate'}`} width={160} class="h-20 w-20 shrink-0 rounded-xl object-cover" />
    ) : (
      <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent">
        <Icon name={icon} size={21} />
      </span>
    )
  }
  <div class="min-w-0 flex-1">
    <p class="font-medium leading-snug text-ink">{a.title}</p>
    {a.credential && <p class="mt-0.5 text-sm font-medium text-accent">“{a.credential}”</p>}
    <p class="mt-1 text-sm text-muted">
      {a.issuer}
      {when && <span class="font-mono text-xs"> · {when}</span>}
      {a.validUntil && <span class="font-mono text-xs"> · valid until {formatDate(a.validUntil)}</span>}
    </p>
    {a.description && <p class="mt-2 text-sm leading-relaxed text-ink-soft">{a.description}</p>}
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="chip">{a.category}</span>
      {
        a.credentialUrl && (
          <a href={a.credentialUrl} target="_blank" rel="noopener noreferrer" class="chip hover:border-accent hover:text-accent">
            <Icon name="external" size={12} /> Verify credential<span class="sr-only"> (opens in a new tab)</span>
          </a>
        )
      }
      {
        a.album && (
          <a href={url(`/gallery/${a.album.id}`)} class="chip hover:border-accent hover:text-accent">
            <Icon name="image" size={12} /> Album
          </a>
        )
      }
      <VerifyBadge notes={a.verify} />
    </div>
  </div>
</li>
