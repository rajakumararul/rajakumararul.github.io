---
/** Standard inner page: page header (eyebrow, title, intro) above the content. */
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  eyebrow?: string;
  intro?: string;
  description?: string;
}
const { title, eyebrow, intro, description } = Astro.props;
---

<BaseLayout title={title} description={description ?? intro}>
  <section class="relative overflow-hidden border-b border-line">
    <div class="bg-grid pointer-events-none absolute inset-0 opacity-60"></div>
    <div class="container-page relative pb-14 pt-32 sm:pb-20 sm:pt-40">
      {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
      <h1 class="max-w-3xl font-serif text-4xl font-medium tracking-tight text-ink sm:text-6xl">{title}</h1>
      {intro && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{intro}</p>}
    </div>
  </section>
  <div class="container-page py-16 sm:py-24">
    <slot />
  </div>
</BaseLayout>
