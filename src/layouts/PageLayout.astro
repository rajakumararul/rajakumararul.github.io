---
/** Standard inner page: page header (eyebrow, title, intro) above the content. */
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  /** Visible page heading when it should differ from the short <title>. */
  heading?: string;
  eyebrow?: string;
  intro?: string;
  description?: string;
  ogType?: 'website' | 'article' | 'profile';
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, heading, eyebrow, intro, description, ogType, image, jsonLd } = Astro.props;
---

<BaseLayout title={title} description={description ?? intro} ogType={ogType} image={image} jsonLd={jsonLd}>
  <section class="relative overflow-hidden border-b border-line">
    <div class="bg-grid pointer-events-none absolute inset-0 opacity-60"></div>
    <div class="container-page relative pb-14 pt-32 sm:pb-20 sm:pt-40">
      {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
      <h1
        class:list={[
          'font-serif font-medium tracking-tight text-ink',
          heading ? 'max-w-4xl text-4xl leading-[1.08] sm:text-[3.4rem]' : 'max-w-3xl text-4xl sm:text-6xl',
        ]}
      >
        {heading ?? title}
      </h1>
      {intro && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{intro}</p>}
    </div>
  </section>
  <div class="container-page py-16 sm:py-24">
    <slot />
  </div>
</BaseLayout>
