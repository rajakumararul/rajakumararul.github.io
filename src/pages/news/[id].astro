---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';
import VerifyBadge from '../../components/VerifyBadge.astro';
import { formatDate, formatRange } from '../../lib/format';
import { getNews, newsCategoryIcon, newsCategoryLabel, newsCover, type News } from '../../lib/news';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((item, i) => ({
    params: { id: item.id },
    props: { item, newer: news[i - 1], older: news[i + 1] },
  }));
}

interface Props {
  item: News;
  newer?: News;
  older?: News;
}
const { item, newer, older } = Astro.props;
const n = item.data;
const { Content } = await render(item);
const cover = await newsCover(item);
const album = n.album ? await getEntry(n.album) : undefined;
const project = n.project ? await getEntry(n.project) : undefined;
const achievement = n.achievement ? await getEntry(n.achievement) : undefined;
const areas = (await getCollection('researchAreas')).filter((a) => (n.areas as string[]).includes(a.id));
const activities = await getCollection('activities', (a) => a.data.news?.id === item.id);
---

<PageLayout
  title={n.title}
  heading={n.title}
  eyebrow={newsCategoryLabel[n.category]}
  description={n.summary}
  ogType="article"
>
  <div class="grid gap-10 lg:grid-cols-12">
    <article class="lg:col-span-8">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm">
        <a href={url('/news')} class="inline-flex items-center gap-1.5 text-muted hover:text-ink">
          <Icon name="chevron-left" size={15} /> All news
        </a>
      </nav>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
        {n.date && <time datetime={n.date} class="font-mono text-sm text-muted">{formatDate(n.date, 'long')}</time>}
        <span class="inline-flex items-center gap-1 text-xs font-medium uppercase tracking-[0.12em] text-accent">
          <Icon name={newsCategoryIcon[n.category]} size={14} />
          {newsCategoryLabel[n.category]}
        </span>
      </p>
      <p class="mt-4 text-xl leading-relaxed text-ink-soft">{n.summary}</p>
      <VerifyBadge notes={n.verify} class="mt-3" />

      {
        cover && (
          <figure class="mt-8 overflow-hidden rounded-2xl border border-line">
            <Image src={cover.src} alt={cover.alt} width={1200} widths={[640, 960, 1200]} sizes="(min-width: 1024px) 760px, 100vw" class="w-full" />
            {cover.credit && (
              <figcaption class="border-t border-line px-4 py-2 text-[0.7rem] text-muted">
                Photo:{' '}
                <a href={cover.credit.sourceUrl} target="_blank" rel="noopener noreferrer" class="link-underline hover:text-ink">
                  {cover.credit.creator} / {cover.credit.provider}
                </a>
              </figcaption>
            )}
          </figure>
        )
      }

      <div class="prose-news mt-8 space-y-4 text-[1.05rem] leading-relaxed text-ink-soft">
        <Content />
      </div>

      {
        n.link && (
          <a href={n.link} target="_blank" rel="noopener noreferrer" class="btn btn-ghost mt-8">
            <Icon name="external" size={16} /> Read more at the source<span class="sr-only"> (opens in a new tab)</span>
          </a>
        )
      }
    </article>

    <aside class="grid content-start gap-4 lg:col-span-4" aria-label="Related">
      {
        album && (
          <a href={url(`/gallery/${album.id}`)} class="card card-hover group block overflow-hidden">
            <span class="block p-5">
              <span class="eyebrow">Photographs</span>
              <span class="mt-1 block font-serif text-lg text-ink group-hover:text-accent-ink">{album.data.title}</span>
              <span class="mt-1 inline-flex items-center gap-1 text-sm text-muted">
                View album <Icon name="arrow-right" size={14} />
              </span>
            </span>
          </a>
        )
      }
      {
        project && (
          <a href={url(`/projects/${project.id}`)} class="card card-hover group block p-5">
            <span class="eyebrow">Related project</span>
            <span class="mt-1 block font-serif text-lg text-ink group-hover:text-accent-ink">{project.data.shortTitle ?? project.data.title}</span>
            <span class="mt-1 block text-sm text-muted">{project.data.funder} · {formatRange(project.data.start, project.data.end)}</span>
          </a>
        )
      }
      {
        achievement && (
          <a href={url('/about#honours-title')} class="card card-hover group block p-5">
            <span class="eyebrow">{achievement.data.kind === 'certification' ? 'Certification' : 'Recognition'}</span>
            <span class="mt-1 block font-serif text-lg text-ink group-hover:text-accent-ink">{achievement.data.title}</span>
            <span class="mt-1 block text-sm text-muted">{achievement.data.issuer}</span>
          </a>
        )
      }
      {
        activities.map((a) => (
          <a href={url(`/activities#${a.id}`)} class="card card-hover group block p-5">
            <span class="eyebrow">Activity</span>
            <span class="mt-1 block font-serif text-lg text-ink group-hover:text-accent-ink">{a.data.title}</span>
          </a>
        ))
      }
      {
        areas.length > 0 && (
          <div class="card p-5">
            <p class="eyebrow mb-3">Research themes</p>
            <ul class="flex flex-wrap gap-2">
              {areas.map((a) => (
                <li>
                  <a href={url(`/research#${a.id}`)} class="chip hover:border-accent hover:text-accent">
                    {a.data.chip ?? a.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </aside>
  </div>

  <nav class="mt-16 grid gap-4 border-t border-line pt-8 sm:grid-cols-2" aria-label="More news">
    {
      newer ? (
        <a href={url(`/news/${newer.id}`)} class="group">
          <span class="inline-flex items-center gap-1 text-xs text-muted">
            <Icon name="arrow-right" size={13} class="rotate-180" /> Newer
          </span>
          <span class="mt-1 block font-serif text-lg text-ink group-hover:text-accent-ink">{newer.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      older && (
        <a href={url(`/news/${older.id}`)} class="group text-right">
          <span class="inline-flex items-center gap-1 text-xs text-muted">
            Older <Icon name="arrow-right" size={13} />
          </span>
          <span class="mt-1 block font-serif text-lg text-ink group-hover:text-accent-ink">{older.data.title}</span>
        </a>
      )
    }
  </nav>
</PageLayout>
