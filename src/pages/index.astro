---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ResearchAreas from '../components/home/ResearchAreas.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import SelectedPublications from '../components/home/SelectedPublications.astro';
import Leadership from '../components/home/Leadership.astro';
import LatestNews from '../components/home/LatestNews.astro';
import AcademicMoments from '../components/home/AcademicMoments.astro';
import Spotlight from '../components/Spotlight.astro';
import { personJsonLd } from '../lib/seo';

const jsonLd = await personJsonLd(Astro.site);
---

<BaseLayout ogType="profile" jsonLd={jsonLd}>
  <Hero />
  <ResearchAreas />
  <FeaturedProjects />
  <SelectedPublications />
  <Leadership />
  <LatestNews />
  <AcademicMoments />
  <Spotlight />
</BaseLayout>
