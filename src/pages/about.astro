---
import { getCollection, getEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import AchievementItem from '../components/AchievementItem.astro';
import VerifyBadge from '../components/VerifyBadge.astro';
import DownloadCV from '../components/DownloadCV.astro';
import { personJsonLd } from '../lib/seo';
import { formatRange, dateKey } from '../lib/format';

const profile = (await getEntry('profile', 'main'))!.data;
const education = (await getCollection('education')).sort((a, b) => b.data.year - a.data.year);
const experience = (await getCollection('experience')).sort((a, b) => dateKey(b.data.start).localeCompare(dateKey(a.data.start)));
const achievements = (await getCollection('achievements')).sort((a, b) => a.data.order - b.data.order);
const honours = achievements.filter((a) => a.data.kind !== 'certification');
const certifications = achievements.filter((a) => a.data.kind === 'certification');
/** Location parts not already named in the organisation, e.g. "…, Chennai" + "Chennai, India" → ", India". */
const placeSuffix = (org: string, loc?: string) => {
  const rest = (loc ?? '').split(',').map((p) => p.trim()).filter((p) => p && !org.includes(p));
  return rest.length ? `, ${rest.join(', ')}` : '';
};
const jsonLd = { ...(await personJsonLd(Astro.site)), description: profile.bio[0] };
const tracks = [
  { id: 'academic', label: 'Academic positions' },
  { id: 'research', label: 'Research positions' },
  { id: 'advisory', label: 'Advisory & industry roles' },
] as const;
---

<PageLayout
  title="About"
  eyebrow="Profile"
  intro={`${profile.designation} and ${profile.leadershipRole}, ${profile.institutionShort}.`}
  description={`About ${profile.shortName} — ${profile.designation} and ${profile.leadershipRole} at ${profile.institution}: biography, education, experience, honours and certifications.`}
  ogType="profile"
  jsonLd={jsonLd}
>
  <!-- Biography -->
  <section class="grid gap-10 lg:grid-cols-12" aria-labelledby="bio-title">
    <div class="lg:col-span-7">
      <h2 id="bio-title" class="sr-only">Biography</h2>
      <div class="space-y-5 text-[1.05rem] leading-relaxed text-ink-soft">
        {profile.bio.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <aside class="lg:col-span-5">
      <div class="card p-6 sm:p-8">
        <p class="eyebrow mb-4">At a glance</p>
        <dl class="grid gap-3 text-sm">
          <div><dt class="text-muted">Position</dt><dd class="font-medium text-ink">{profile.designation}</dd></div>
          <div><dt class="text-muted">Leadership</dt><dd class="font-medium text-ink">{profile.leadershipRole}</dd></div>
          <div><dt class="text-muted">School</dt><dd class="text-ink-soft">{profile.school}</dd></div>
          <div><dt class="text-muted">Institution</dt><dd class="text-ink-soft">{profile.institution}</dd></div>
        </dl>
        <div class="mt-6 border-t border-line pt-6">
          <SocialLinks placement="about" variant="list" />
        </div>
        <DownloadCV variant="primary" class="mt-6" />
      </div>
    </aside>
  </section>

  <!-- Education -->
  <section class="mt-20" aria-labelledby="edu-title">
    <p class="eyebrow mb-3">Qualifications</p>
    <h2 id="edu-title" class="font-serif text-3xl text-ink">Education</h2>
    <ol class="mt-8 grid gap-4 md:grid-cols-2">
      {
        education.map((e) => (
          <li class="card p-6">
            <p class="font-mono text-xs text-muted">{e.data.year}</p>
            <p class="mt-1 font-serif text-xl text-ink">
              {e.data.degree}, {e.data.field}
            </p>
            <p class="mt-1 text-sm text-muted">{e.data.institution}</p>
            {e.data.detail && <p class="mt-3 text-sm leading-relaxed text-ink-soft">{e.data.detail}</p>}
            <VerifyBadge notes={e.data.verify} class="mt-3" />
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Experience -->
  <section class="mt-20" aria-labelledby="exp-title">
    <p class="eyebrow mb-3">Career</p>
    <h2 id="exp-title" class="font-serif text-3xl text-ink">Experience</h2>
    <div class="mt-8 grid gap-10 lg:grid-cols-3">
      {
        tracks.map((t) => (
          <div>
            <p class="mb-4 text-sm font-medium text-ink-soft">{t.label}</p>
            <ol class="border-l border-line">
              {experience
                .filter((e) => e.data.track === t.id)
                .map((e) => (
                  <li class="relative pb-6 pl-6 last:pb-0">
                    <span class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-accent bg-bg" />
                    <p class="font-mono text-xs text-muted">{formatRange(e.data.start, e.data.end)}</p>
                    <p class="mt-1 font-medium text-ink">{e.data.title}</p>
                    <p class="text-sm text-muted">
                      {e.data.organisation}
                      {placeSuffix(e.data.organisation, e.data.location)}
                    </p>
                  </li>
                ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Honours -->
  <section class="mt-20" aria-labelledby="honours-title">
    <p class="eyebrow mb-3">Recognition</p>
    <h2 id="honours-title" class="font-serif text-3xl text-ink">Honours & awards</h2>
    <ul class="mt-8 grid gap-4 md:grid-cols-2">
      {honours.map((item) => <AchievementItem item={item} />)}
    </ul>
  </section>

  <!-- Certifications -->
  <section class="mt-20" aria-labelledby="cert-title">
    <p class="eyebrow mb-3">Professional development</p>
    <h2 id="cert-title" class="font-serif text-3xl text-ink">Certifications</h2>
    <ul class="mt-8 grid gap-4 md:grid-cols-2">
      {certifications.map((item) => <AchievementItem item={item} />)}
    </ul>
  </section>

  <!-- Memberships -->
  <section class="mt-20" aria-labelledby="mem-title">
    <p class="eyebrow mb-3">Professional bodies</p>
    <h2 id="mem-title" class="font-serif text-3xl text-ink">Memberships</h2>
    <ul class="mt-8 flex flex-wrap gap-3">
      {
        profile.memberships.map((m) => (
          <li class="chip px-4! py-2! text-sm!">
            <Icon name="users" size={15} class="text-accent" /> {m}
          </li>
        ))
      }
    </ul>
  </section>
</PageLayout>
