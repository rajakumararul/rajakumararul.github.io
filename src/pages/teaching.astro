---
import { getCollection, getEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
import VerifyBadge from '../components/VerifyBadge.astro';
import { activityDate, getActivities } from '../lib/activities';
import { url } from '../lib/url';

const items = (await getCollection('teaching')).sort((a, b) => a.data.order - b.data.order);
const courses = items.filter((i) => i.data.kind === 'course' && i.data.show);
const resources = items.filter((i) => i.data.kind === 'resource' && i.data.url);
const projectThemes = items.filter((i) => i.data.kind === 'project' && i.data.show);
const qll = await getEntry('innovations', 'quantum-learning-lab');
const mentoring = await getActivities((a) => ['mentoring', 'hackathon', 'industry', 'outreach'].includes(a.data.category));

const philosophy = [
  {
    icon: 'compass',
    title: 'Conceptual clarity first',
    text: 'Every topic starts from the idea behind it — why an algorithm works, what a qubit really represents — before notation and code.',
  },
  {
    icon: 'spark',
    title: 'Visual and interactive',
    text: 'Pictures and interactive models carry ideas further than equations alone: Bloch-sphere rotations, circuit diagrams and step-by-step state evolution.',
  },
  {
    icon: 'layers',
    title: 'Hands-on experimentation',
    text: 'Students build and run what they learn — on simulators and cloud quantum platforms — and learn as much from failed runs as from successful ones.',
  },
  {
    icon: 'link',
    title: 'From algorithms to implementations',
    text: 'Algorithms are connected to real implementations and their costs, so that complexity, correctness and performance are understood together.',
  },
  {
    icon: 'file',
    title: 'Research-informed',
    text: 'Current research in quantum computing, post-quantum cryptography and network security feeds directly into examples, assignments and projects.',
  },
  {
    icon: 'users',
    title: 'Problem solving together',
    text: 'Open problems, team projects and discussion build the habits students need beyond the classroom.',
  },
];
const quantumFocus = ['Visual understanding of qubits', 'Bloch sphere representation', 'Quantum circuits', 'Simulation', 'Programming-based experimentation with Qiskit'];
const resourceIcon = { 'lab-manual': 'book', repository: 'github', tool: 'atom', course: 'layers', video: 'youtube' } as const;
---

<PageLayout
  title="Teaching"
  eyebrow="Teaching"
  intro="Teaching that moves from intuition to implementation — with quantum computing taught visually, interactively and hands-on."
  description="Teaching portfolio of Dr. Rajakumar Arul: teaching philosophy, quantum computing education, the Quantum Learning Lab, teaching resources and student projects."
>
  <!-- Philosophy -->
  <section aria-labelledby="philosophy-title">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow mb-3">Teaching philosophy</p>
        <h2 id="philosophy-title" class="font-serif text-3xl text-ink sm:text-4xl">From intuition to implementation</h2>
        <p class="mt-5 leading-relaxed text-ink-soft">
          Good teaching makes a difficult idea feel inevitable. My classes aim for conceptual clarity first, then build
          skill through problem solving, visual and interactive learning, and hands-on experimentation — always linking
          the algorithm on the board to an implementation that runs.
        </p>
        <p class="mt-4 leading-relaxed text-ink-soft">
          In quantum computing this means seeing a qubit before writing its state vector: rotating it on the Bloch sphere,
          composing gates into circuits, simulating them, and then programming real experiments.
        </p>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
        {
          philosophy.map((p) => (
            <li class="card p-5">
              <span class="grid h-9 w-9 place-items-center rounded-lg bg-accent-soft text-accent">
                <Icon name={p.icon} size={18} />
              </span>
              <h3 class="mt-3 font-medium text-ink">{p.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-muted">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Courses (only confirmed courses are listed) -->
  {
    courses.length > 0 && (
      <section class="mt-20" aria-labelledby="courses-title">
        <p class="eyebrow mb-3">Courses</p>
        <h2 id="courses-title" class="font-serif text-3xl text-ink sm:text-4xl">Current & recent teaching</h2>
        <ul class="mt-8 grid gap-4 md:grid-cols-2">
          {courses.map((c) => (
            <li class="card p-6">
              {c.data.level && <p class="font-mono text-xs text-muted">{c.data.level}</p>}
              <h3 class="mt-1 font-serif text-xl text-ink">{c.data.title}</h3>
              {c.data.description && <p class="mt-2 text-sm leading-relaxed text-muted">{c.data.description}</p>}
              <VerifyBadge notes={c.data.verify} class="mt-3" />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Quantum computing education -->
  <section id="quantum-education" class="mt-20 scroll-mt-28" aria-labelledby="qe-title">
    <div class="card relative overflow-hidden p-7 sm:p-10">
      <div class="bg-grid pointer-events-none absolute inset-0 opacity-40"></div>
      <div class="relative grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <p class="eyebrow mb-3">Quantum computing education</p>
          <h2 id="qe-title" class="font-serif text-3xl text-ink sm:text-4xl">Seeing quantum mechanics at work</h2>
          <p class="mt-5 leading-relaxed text-ink-soft">
            Quantum computing is easier to learn when students can see and touch it. Teaching combines interactive
            visualisation, hands-on Qiskit activities, quantum circuit experiments and educational prototypes built with
            students.
          </p>
          <ul class="mt-6 flex flex-wrap gap-2">
            {quantumFocus.map((q) => <li class="chip">{q}</li>)}
          </ul>
        </div>
        {
          qll && (
            <div class="lg:col-span-5">
              <div class="rounded-2xl border border-line bg-surface p-6">
                <p class="font-mono text-[0.65rem] uppercase tracking-[0.16em] text-accent">Interactive learning tool</p>
                <h3 class="mt-2 font-serif text-2xl text-ink">{qll.data.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{qll.data.description}</p>
                <div class="mt-5 flex flex-wrap gap-3">
                  {qll.data.liveUrl && (
                    <a href={qll.data.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                      Explore Quantum Learning Lab <Icon name="arrow-up-right" size={16} />
                      <span class="sr-only">(opens in a new tab)</span>
                    </a>
                  )}
                  <a href={url('/projects#quantum-learning-lab')} class="btn btn-ghost">About the project</a>
                </div>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- Resources -->
  {
    resources.length > 0 && (
      <section class="mt-20" aria-labelledby="resources-title">
        <p class="eyebrow mb-3">Teaching resources</p>
        <h2 id="resources-title" class="font-serif text-3xl text-ink sm:text-4xl">Open resources for learners</h2>
        <ul class="mt-8 grid gap-4 md:grid-cols-2">
          {resources.map((r) => (
            <li>
              <a href={r.data.url} target="_blank" rel="noopener noreferrer" class="card card-hover group flex h-full items-start gap-4 p-5">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent">
                  <Icon name={resourceIcon[r.data.resourceType ?? 'tool']} size={20} />
                </span>
                <span>
                  <span class="block font-medium text-ink group-hover:text-accent-ink">
                    {r.data.title}
                    <Icon name="arrow-up-right" size={13} class="ml-0.5 inline text-muted" />
                  </span>
                  {r.data.description && <span class="mt-1 block text-sm leading-relaxed text-muted">{r.data.description}</span>}
                  <span class="sr-only">(opens in a new tab)</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Student projects & mentoring -->
  <section class="mt-20" aria-labelledby="students-title">
    <p class="eyebrow mb-3">Student projects & mentoring</p>
    <h2 id="students-title" class="font-serif text-3xl text-ink sm:text-4xl">Learning by building</h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-muted">
      Selected project themes students have explored — from physical teaching aids to cryptographic implementations.
    </p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        projectThemes.map((p) => (
          <li class="card p-6">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-bg-soft text-ink-soft">
              <Icon name={p.data.areas.includes('quantum-key-distribution') ? 'photon' : p.data.areas.includes('post-quantum-cryptography') ? 'lattice' : 'atom'} size={20} />
            </span>
            <h3 class="mt-4 font-serif text-lg text-ink">{p.data.title}</h3>
            {p.data.description && <p class="mt-2 text-sm leading-relaxed text-muted">{p.data.description}</p>}
          </li>
        ))
      }
      {
        qll && (
          <li class="flex flex-col justify-center rounded-2xl border border-dashed border-line-strong p-6">
            <p class="text-sm leading-relaxed text-muted">Many of these themes connect to the</p>
            <a href={url('/projects#quantum-learning-lab')} class="mt-1 inline-flex items-center gap-1.5 font-serif text-lg text-ink hover:text-accent-ink">
              {qll.data.title} <Icon name="arrow-right" size={16} />
            </a>
          </li>
        )
      }
    </ul>

    {
      mentoring.length > 0 && (
        <div class="mt-12">
          <h3 class="font-medium text-ink">Mentoring</h3>
          <ul class="mt-4 grid gap-3 md:grid-cols-2">
            {mentoring.map((m) => (
              <li class="flex items-start gap-4 rounded-2xl border border-line p-5">
                <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-accent-soft text-accent">
                  <Icon name="users" size={17} />
                </span>
                <div>
                  <a href={url(`/activities#${m.id}`)} class="font-medium text-ink hover:text-accent-ink">{m.data.title}</a>
                  <p class="text-sm text-muted">{[m.data.role, activityDate(m)].filter(Boolean).join(' · ')}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>
</PageLayout>
